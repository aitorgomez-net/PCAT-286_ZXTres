# ZXTRES+ constraints for PCAT-286 with DeMiSTify. Pin locations come from
# DeMiSTify/templates/zxtres/zxtres.xdc (somhi); bitstream options follow the
# ZXTRES test card core (github.com/zxtres/test_carta_ajuste).

set_property BITSTREAM.CONFIG.SPI_32BIT_ADDR YES [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN PULLUP [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CFGBVS VCCO [current_design]

set_property PACKAGE_PIN Y18 [get_ports CLOCK_50]
set_property IOSTANDARD LVCMOS33 [get_ports CLOCK_50]
